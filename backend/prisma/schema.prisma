generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// NEGÓCIO E LOJAS
// ═══════════════════════════════════════════════════════

// Representa o cliente do GestorFlow (ex: "Jaque", "Salão da Amanda").
// Todo dado do sistema pertence, direta ou indiretamente, a um Negocio.
model Negocio {
  id            Int      @id @default(autoincrement())
  nome          String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Lista de módulos ativos para este negócio (ex: ["produtos","vendas","caixa"]).
  // O frontend usa isso para decidir o que mostrar no menu.
  // Se vazio/null, o sistema assume o conjunto padrão completo.
  modulosAtivos String[] @default(["produtos", "vendas", "categorias", "fornecedores", "caixa", "relatorios", "clientes"])

  // Dia do mês (1-28) em que as vendas fiado vencem. Toda venda
  // fiado vence sempre no MÊS SEGUINTE a quando foi feita, nesse
  // dia — nunca no mesmo mês da compra, para manter o prazo
  // consistente entre vendas feitas em datas diferentes do mês.
  diaVencimentoFiado Int @default(20)

  lojas         Loja[]
  clientes      Cliente[]
  usuarios      User[]
  usuarioNegocios UsuarioNegocio[]
}

// Uma unidade física do negócio (ex: "Loja Centro", "Loja Norte").
// Todo negócio tem ao menos 1 loja, mesmo que seja uso solo.
model Loja {
  id         Int      @id @default(autoincrement())
  nome       String
  endereco   String?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  negocioId  Int
  negocio    Negocio  @relation(fields: [negocioId], references: [id])

  usuarios     UsuarioLoja[]
  produtos     Product[]
  vendas       Sale[]
  categorias   Categoria[]
  fornecedores Fornecedor[]
  caixas       Caixa[]
}

// ═══════════════════════════════════════════════════════
// USUÁRIOS
// ═══════════════════════════════════════════════════════

// Login único no sistema (não é email pessoal — ver decisão registrada).
// Um usuário pertence a um Negocio, e pode atuar em uma ou mais Lojas
// desse negócio, cada vínculo com seu próprio role (ex: CAIXA na
// Loja Centro e GERENTE na Loja Norte).
model User {
  id         Int      @id @default(autoincrement())
  nome       String
  usuario    String   @unique // login interno, ex: "joao.silva" — não é email
  senha      String
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Força a troca de senha no próximo login. Liga automaticamente
  // na criação do usuário, e pode ser religada manualmente pelo
  // ADMIN a qualquer momento (ex: reset de senha).
  precisaTrocarSenha Boolean @default(true)

  // SUPER_ADMIN não pertence a um negócio específico (é o dono da
  // plataforma, Renato) — por isso negocioId é opcional.
  negocioId  Int?
  negocio    Negocio? @relation(fields: [negocioId], references: [id])

  isSuperAdmin Boolean @default(false)

  lojas      UsuarioLoja[]
  sales      Sale[]
  usuarioNegocios UsuarioNegocio[]
  movimentosEstoque MovimentoEstoque[]
  pagamentosFiado PagamentoFiado[]
}

// Relação N:N entre User e Loja, com o role específico naquele vínculo.
model UsuarioLoja {
  id       Int   @id @default(autoincrement())
  role     Role  @default(CAIXA)

  userId   Int
  lojaId   Int
  user     User  @relation(fields: [userId], references: [id])
  loja     Loja  @relation(fields: [lojaId], references: [id])

  @@unique([userId, lojaId]) // não faz sentido o mesmo vínculo duas vezes
}

// Relação auxiliar N:N entre User e Negocio, útil para consultas
// rápidas de "quais usuários pertencem a este negócio" sem precisar
// atravessar Loja. Mantida em sincronia com UsuarioLoja pelo backend.
model UsuarioNegocio {
  id        Int     @id @default(autoincrement())
  userId    Int
  negocioId Int
  user      User    @relation(fields: [userId], references: [id])
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  @@unique([userId, negocioId])
}

enum Role {
  ADMIN
  GERENTE
  CAIXA
}

// ═══════════════════════════════════════════════════════
// CLIENTES (do negócio, não de uma loja específica —
// um cliente da Jaque pode comprar em qualquer uma das 4 lojas)
// ═══════════════════════════════════════════════════════
model Cliente {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String?
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  negocioId   Int
  negocio     Negocio  @relation(fields: [negocioId], references: [id])

  sales       Sale[]
}

// ═══════════════════════════════════════════════════════
// CATEGORIAS (por loja)
//
// Suporta até 2 níveis: uma Categoria "raiz" (ex: Perfumes) pode
// ter Subcategorias (ex: Masculino, Feminino) através do campo
// categoriaPaiId, que aponta para a própria tabela Categoria.
//
// Uma Categoria SEM categoriaPaiId é uma categoria raiz (nível 1).
// Uma Categoria COM categoriaPaiId é uma subcategoria (nível 2) —
// e nesse caso, não pode ter subcategorias dela mesma (o backend
// valida isso no controller, não dá pra impedir só com o schema).
//
// Produto pode apontar tanto para uma categoria raiz (ex: uma loja
// de conveniência usando só "Bebidas", sem dividir mais) quanto
// para uma subcategoria (ex: "Masculino" dentro de "Perfumes").
// ═══════════════════════════════════════════════════════
model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String

  lojaId   Int
  loja     Loja      @relation(fields: [lojaId], references: [id])

  // Auto-relacionamento: se preenchido, esta categoria é uma
  // subcategoria de outra. Se null, é uma categoria raiz.
  categoriaPaiId Int?
  categoriaPai   Categoria?  @relation("SubcategoriaDe", fields: [categoriaPaiId], references: [id])
  subcategorias  Categoria[] @relation("SubcategoriaDe")

  produtos Product[]

  @@unique([nome, lojaId, categoriaPaiId]) // nome único dentro do mesmo pai e loja
}

// ═══════════════════════════════════════════════════════
// FORNECEDORES (por loja)
// ═══════════════════════════════════════════════════════
model Fornecedor {
  id       Int       @id @default(autoincrement())
  nome     String
  telefone String?
  email    String?

  lojaId   Int
  loja     Loja      @relation(fields: [lojaId], references: [id])

  produtos Product[]
}

// ═══════════════════════════════════════════════════════
// PRODUTOS (por loja — estoque é físico, não compartilhado)
// ═══════════════════════════════════════════════════════
model Product {
  id             Int        @id @default(autoincrement())
  nome           String
  codigoBarras   String?
  preco          Float
  precoCusto     Float?
  estoque        Int        @default(0)
  estoqueMinimo  Int        @default(5)
  ativo          Boolean    @default(true)

  lojaId         Int
  loja           Loja        @relation(fields: [lojaId], references: [id])

  categoriaId    Int?
  fornecedorId   Int?
  categoria      Categoria?  @relation(fields: [categoriaId], references: [id])
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id])

  itensVenda     ItemVenda[]
  movimentos     MovimentoEstoque[]

  @@unique([codigoBarras, lojaId]) // código de barras único por loja, não globalmente
}

// ═══════════════════════════════════════════════════════
// MOVIMENTO DE ESTOQUE
//
// Registra cada entrada ou saída de estoque de um produto, com
// data e motivo. O campo `estoque` do Product continua sendo o
// número atual (fica sempre atualizado a cada movimento), mas
// esta tabela guarda o histórico de como ele chegou naquele valor.
//
// Saídas por venda são registradas automaticamente pelo
// saleController (tipo SAIDA, motivo "Venda #123"). Entradas
// manuais (reposição de fornecedor, por exemplo) são registradas
// pelo usuário através do botão "+ Registrar entrada" na tela
// de Produtos.
// ═══════════════════════════════════════════════════════
model MovimentoEstoque {
  id         Int              @id @default(autoincrement())
  tipo       TipoMovimento
  quantidade Int              // sempre positivo; o `tipo` indica se soma ou subtrai
  motivo     String?
  data       DateTime         @default(now())

  productId  Int
  product    Product          @relation(fields: [productId], references: [id])

  userId     Int?             // quem registrou (null para movimentos automáticos antigos, se houver)
  user       User?            @relation(fields: [userId], references: [id])
}

enum TipoMovimento {
  ENTRADA
  SAIDA
}

// ═══════════════════════════════════════════════════════
// VENDAS (por loja)
// ═══════════════════════════════════════════════════════
model Sale {
  id             Int            @id @default(autoincrement())
  data_venda     DateTime       @default(now())
  valor_total    Float
  desconto       Float          @default(0)
  formaPagamento FormaPagamento @default(DINHEIRO)
  status         StatusVenda    @default(CONCLUIDA)
  troco          Float?

  // Preenchido apenas quando formaPagamento é CARTAO_CREDITO e a
  // venda foi parcelada. É só informativo (para relatórios/histórico)
  // — a loja já recebe o valor integral da maquininha rapidamente,
  // quem parcela é o cliente com o banco dele. Não afeta status
  // nem exige clienteId, diferente de uma venda "a prazo".
  numeroParcelas Int?

  lojaId         Int
  loja           Loja           @relation(fields: [lojaId], references: [id])

  userId         Int
  user           User           @relation(fields: [userId], references: [id])

  clienteId      Int?
  cliente        Cliente?       @relation(fields: [clienteId], references: [id])

  itens          ItemVenda[]
  pagamentos     PagamentoFiado[]
  parcelas       ParcelaFiado[]
}

enum FormaPagamento {
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  PIX
  A_PRAZO
}

enum StatusVenda {
  CONCLUIDA
  CANCELADA
  PENDENTE
}

// ═══════════════════════════════════════════════════════
// PARCELA DE VENDA A PRAZO
//
// Uma venda "a prazo" pode ser dividida em várias parcelas, cada
// uma com sua própria data de vencimento (sempre +1 mês a partir
// da primeira, no mesmo dia) e valor atual.
//
// `valorOriginal` é fixo, definido na criação (valor_total dividido
// igualmente pelo número de parcelas). `valorAtual` é o que
// efetivamente falta pagar dessa parcela — muda quando um pagamento
// é registrado: a lógica de negócio (no controller) abate primeiro
// a parcela mais próxima do vencimento e redistribui qualquer
// sobra igualmente entre as parcelas futuras ainda PENDENTES.
model ParcelaFiado {
  id             Int      @id @default(autoincrement())
  numero         Int      // 1, 2, 3... — ordem dentro da venda
  dataVencimento DateTime
  valorOriginal  Float
  valorAtual     Float
  status         StatusParcela @default(PENDENTE)

  saleId         Int
  sale           Sale     @relation(fields: [saleId], references: [id])

  pagamentos     PagamentoFiado[]
}

enum StatusParcela {
  PENDENTE
  PAGA
}

// ═══════════════════════════════════════════════════════
// PAGAMENTO DE FIADO
//
// Cada linha registra um pagamento (parcial ou total) recebido.
// Vinculado à parcela que foi abatida primeiro — se o pagamento
// for maior que o saldo dessa parcela, o excedente redistribui o
// valorAtual das parcelas futuras (lógica no controller), mas o
// registro do PagamentoFiado em si sempre aponta para a parcela
// que originou o recebimento.
// ═══════════════════════════════════════════════════════
model PagamentoFiado {
  id          Int      @id @default(autoincrement())
  valor       Float
  data        DateTime @default(now())

  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id])

  parcelaId   Int?
  parcela     ParcelaFiado? @relation(fields: [parcelaId], references: [id])

  userId      Int      // quem registrou o recebimento (ADMIN/GERENTE)
  user        User     @relation(fields: [userId], references: [id])
}

// ═══════════════════════════════════════════════════════
// ITENS DA VENDA
// ═══════════════════════════════════════════════════════
model ItemVenda {
  id            Int     @id @default(autoincrement())
  quantidade    Int
  precoUnitario Float
  subtotal      Float

  saleId        Int
  productId     Int
  sale          Sale    @relation(fields: [saleId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
}

// ═══════════════════════════════════════════════════════
// CAIXA (por loja)
// ═══════════════════════════════════════════════════════
model Caixa {
  id           Int         @id @default(autoincrement())
  abertura     DateTime    @default(now())
  fechamento   DateTime?
  valorInicial Float
  valorFinal   Float?
  status       StatusCaixa @default(ABERTO)

  lojaId       Int
  loja         Loja        @relation(fields: [lojaId], references: [id])
}

enum StatusCaixa {
  ABERTO
  FECHADO
}
